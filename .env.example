# Domaine existant utilisé pour les canonical, hreflang, sitemap et partages.
NEXT_PUBLIC_SITE_URL=https://www.studiopickles.io

# Facultatif : code fourni par Google Search Console pour la vérification HTML.
GOOGLE_SITE_VERIFICATION=

# Mettre false pour empêcher l’indexation d’un environnement de test.
# Les déploiements Preview de Vercel sont exclus automatiquement.
SITE_INDEXING_ENABLED=true
